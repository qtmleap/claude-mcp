# Use an Anthropic-compatible gateway, or leave blank for the Claude CLI default.
ANTHROPIC_BASE_URL=
# Set the credential your provider requires. Leave the other credential empty.
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_API_KEY=
CLAUDE_MCP_MODELS=sonnet,opus,haiku
# Docker host directory to bind into /workspace. Relative paths use this checkout.
CLAUDE_MCP_HOST_WORKSPACE=.
CLAUDE_MCP_PORT=8877
# For native execution, optionally set CLAUDE_MCP_WORKSPACE to your project path.
CLAUDE_MCP_PERMISSION_MODE=acceptEdits
CLAUDE_MCP_ALLOWED_TOOLS=Read,Grep,Glob
CLAUDE_MCP_WAIT_MS=10000
# Generation has no default deadline. Deadlines require explicit execution_timeout_ms.
CLAUDE_MCP_MAX_CONCURRENT_JOBS=4
# Retained job history (results stay available for the retention period; cancel does not free history).
CLAUDE_MCP_MAX_JOBS=128
CLAUDE_MCP_STREAM_DIAGNOSTICS=0
CLAUDE_MCP_JOB_RETENTION_MS=604800000
# Idle HTTP protocol sessions expire after this many ms (1000..86400000); in-flight calls are protected.
CLAUDE_MCP_SESSION_IDLE_MS=300000
CLAUDE_MCP_MAX_SESSIONS=64
# Resumable review chains (private; default: sessions/ beside the job dir, same persistent volume).
# CLAUDE_MCP_SESSION_DIR=
